/-
  DRBound.PageTable — the one run of the exact table (`Exact.tableValues 18`: rebuilds the 1.34-billion-entry table,
  minutes and about 2.6 GB) over every DR state on the published pages that comes with a stated optimal finish
  (`Page.pageOptima`, generated by research/src/gen_page_checks.py).  Kept apart so the table is built once; the
  theorems are in DRBound.PageChecks.
-/
import DRBound.CertifiedExact
import DRBound.PageData

namespace DRBound.Page

set_option maxHeartbeats 0

/-- DR moves of a string, `none` if any token is not one of the ten (strict, unlike `parseMoves`). -/
def drMoves? (s : String) : Option (List Move) :=
  ((s.splitOn " ").filter (· != "")).mapM fun t =>
    match t with
    | "U" => some .U | "U2" => some .U2 | "U'" => some .U' | "D" => some .D | "D2" => some .D2 | "D'" => some .D'
    | "R2" => some .R2 | "L2" => some .L2 | "F2" => some .F2 | "B2" => some .B2 | _ => none
def drMoves (s : String) : List Move := (drMoves? s).getD []
/-- The state a scramble makes from solved. -/
def st (scr : String) : State := solved.apply (drMoves scr)

/-- The stated optima, looked up in the exact table. -/
theorem page_table_lookup :
    Exact.tableValues 18 (pageOptima.map fun c => st c.2.1) = pageOptima.map (·.2.2) := by
  native_decide

end DRBound.Page
