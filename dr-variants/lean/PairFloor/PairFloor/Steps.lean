      ind (truePair 6 6 (cf 3) (ef 2)) +
      ind (truePair 7 6 (cf 2) (ef 2)) +
      ind (truePair 7 7 (cf 2) (ef 7)) := rfl

/-- `B2` carries these slots as a whole: a pair there before is a pair after. -/
theorem carried_B2 : ∀ c e : Fin 8,
    truePair 2 2 c e = truePair 7 6 c e ∧
    truePair 3 2 c e = truePair 6 6 c e ∧
    truePair 6 6 c e = truePair 3 2 c e ∧
    truePair 7 6 c e = truePair 2 2 c e := by decide

/-- `B2` splits four slots and carries the rest: the number of true pairs moves by at most 4. -/
theorem step_B2 (cf ef : Fin 8 → Fin 8) :
    pairsF (fun p => cf (Move.B2.srcC.get p)) (fun q => ef (Move.B2.srcE.get q)) ≤ pairsF cf ef + 4 ∧
    pairsF cf ef ≤ pairsF (fun p => cf (Move.B2.srcC.get p)) (fun q => ef (Move.B2.srcE.get q)) + 4 := by
  rw [moved_B2]
  simp only [pairsF, (carried_B2 (cf 7) (ef 6)).1, (carried_B2 (cf 6) (ef 6)).2.1, (carried_B2 (cf 3) (ef 2)).2.2.1, (carried_B2 (cf 2) (ef 2)).2.2.2]
  have := ind_le (truePair 2 1 (cf 7) (ef 1))
  have := ind_le (truePair 3 3 (cf 6) (ef 3))
  have := ind_le (truePair 6 5 (cf 3) (ef 5))
  have := ind_le (truePair 7 7 (cf 2) (ef 7))
  have := ind_le (truePair 2 1 (cf 2) (ef 1))
  have := ind_le (truePair 3 3 (cf 3) (ef 3))
  have := ind_le (truePair 6 5 (cf 6) (ef 5))
  have := ind_le (truePair 7 7 (cf 7) (ef 7))
  omega

end DRBound
