/-
  HTFirst.Examples — the worked DRs of the reference table "Half turns before the first quarter turn" and a
  recount of sampled states, checked against DRBound's proved exact table (`HTFirst.Data`, generated by
  `gen_htfirst.py` from the files the page is printed from).

    examples_optimal        each stated optimal is exact (`exact_optimal`);
    examples_all_finishes   the printed finishes are all the optimal finishes of the DR, and no others
                            (`mem_finishes`): "both optimal finishes …" is about the complete list;
    examples_replay         each printed finish solves its scramble in the stated length and, read from its last
                            move, solves the inverse scramble; the half turns before its first quarter turn on
                            normal and on inverse and its quarter turns are the printed numbers; the subset × edges
                            on both sides; the half turns the corners need on each side, how many of U U' D D'
                            lower the corners at once, ready or not; the fewest quarter turns of any finish;
    examples_lowering       the subsets those lowering quarter turns lead to;
    recount_rows            for the first 200 sampled DRs of 2c4 2e: the optimal, the number of optimal finishes,
                            their fewest and most quarter turns, the fewest half turns before the first quarter
                            turn from either end, and the same over the finishes with no extra quarter turn, are
                            the study's numbers for that state.
-/
import HTFirst.Table
import HTFirst.ExampleDefs

namespace HTFirst
open DRBound HTRRoutes

set_option maxHeartbeats 0

/-- Every scramble and finish of the data is made of the ten DR moves. -/
theorem data_parse_ok :
    (examples.all fun c => (drMoves? c.scr).isSome && c.fin.all fun f => (drMoves? f.1).isSome) ∧
    (recount.all fun c => (drMoves? c.2.1).isSome) := by native_decide

theorem run_split :
    (examples.map fun c => (exactDist (st c.scr), finishes exactTable (st c.scr))) =
        examples.map (fun c => (c.opt, c.fin.map fun f => drMoves f.1)) ∧
    (recount.map fun c => summary (qtFull (st c.2.1)) (exactDist (st c.2.1)) (finishes exactTable (st c.2.1))) =
        recount.map (fun c => c.2.2) := by
  have h := table_run
  rw [tableRun_eq] at h
  have h1 := congrArg Prod.fst h
  have h2 := congrArg Prod.snd h
  simp only [List.map_map] at h1 h2
  exact ⟨h1, h2⟩

/-- **Each stated optimal is exact**: some finish of the DR has that many moves, and none has fewer. -/
theorem examples_optimal : ∀ c ∈ examples,
    (∃ w : List Move, w.length = c.opt ∧ (st c.scr).apply w = solved) ∧
    (∀ w : List Move, (st c.scr).apply w = solved → c.opt ≤ w.length) := by
  intro c hc
  have h := List.map_inj_left.mp run_split.1 c hc
  have hd : exactDist (st c.scr) = c.opt := congrArg Prod.fst h
  obtain ⟨hv, hp⟩ := reachable_good (drMoves c.scr)
  obtain ⟨h1, h2⟩ := exact_optimal (st c.scr) hv hp
  rw [hd] at h1 h2
  exact ⟨h1, h2⟩

/-- **The printed finishes are all the optimal finishes**: a sequence of DR moves solves the DR in the optimal
number of moves exactly when it is one of the printed finishes. -/
theorem examples_all_finishes : ∀ c ∈ examples, ∀ w : List Move,
    (w.length = c.opt ∧ (st c.scr).apply w = solved) ↔ w ∈ c.fin.map (fun f => drMoves f.1) := by
  intro c hc w
  have h := List.map_inj_left.mp run_split.1 c hc
  have hd : exactDist (st c.scr) = c.opt := congrArg Prod.fst h
  have hf : finishes exactTable (st c.scr) = c.fin.map (fun f => drMoves f.1) := congrArg Prod.snd h
  obtain ⟨hv, hp⟩ := reachable_good (drMoves c.scr)
  have hm := mem_finishes (st c.scr) hv hp w
  rw [hf, hd] at hm
  exact hm.symm

/-- **Everything else the page prints about the worked DRs** (`exOK`): the subset × edges on normal and on
inverse; each printed finish solves the scramble in the optimal number of moves and, read from its last move, solves
the inverse scramble; its half turns before the first quarter turn on normal and on inverse and its quarter turns;
the half turns the corners need on each side, how many of U U' D D' lower the corners at once, ready or not; the
fewest quarter turns of any finish (the corners' count on these rows, on both sides); whether an optimal finish has
no extra quarter turn. -/
theorem examples_replay : examples.all exOK = true := by native_decide

#eval examples.map fun c => (c.id, lowersTo (st c.scr), lowersTo (stInv c.scr))

/-- **The recount.**  For each of the recounted sampled DRs: the numbers of the study for that state are the
summary of the list of all its optimal finishes (`mem_finishes`), with the optimal from the proved table. -/
theorem recount_rows : ∀ c ∈ recount,
    summary (qtFull (st c.2.1)) (exactDist (st c.2.1)) (finishes exactTable (st c.2.1)) = c.2.2 :=
  List.map_inj_left.mp run_split.2

/-- The recount is the first 200 sampled DRs of 2c4 2e, and each scramble does make a 2c4 2e. -/
theorem recount_size :
    recount.length = 200 ∧
    (recount.zipIdx.all fun (c, i) => c.1 == s!"2c4 2e #{i}") ∧
    (recount.all fun c => subset48 (st c.2.1) == "2c4 2e") := by native_decide

end HTFirst
